{
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "create-react-app",
      "buildCommand": "npm run build",
      "outputDirectory": "build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
